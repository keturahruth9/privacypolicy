<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Privacy Policy — Translator Pro+</title>
  <meta name="description" content="Privacy Policy for Translator Pro+. We respect your privacy and do not store personal data.">
  <meta name="author" content="Translator Pro+">
  <link rel="canonical" href="https://your-username.github.io/your-repo/translator-pro-plus.html">

  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">

  <style>
    body {
