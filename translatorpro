      box-shadow: 0 10px 40px rgba(0,0,0,0.08);
    }

    h1 {
      font-family: 'Poppins', sans-serif;
      font-size: 2rem;
      margin-bottom: 6px;
      color: #4f46e5;
    }

    small {
      color: #64748b;
      font-weight: 500;
    }

    h2 {
      font-family: 'Poppins', sans-serif;
      font-size: 1.25rem;
      margin-top: 32px;
      color: #6366f1;
    }

    p {
      line-height: 1.8;
      color: #475569;
    }

    ul {
      margin-left: 20px;
    }

    li {
      margin-bottom: 6px;
    }

    a {
      color: #4f46e5;
      font-weight: 600;
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    footer {
      margin-top: 40px;
      text-align: center;
